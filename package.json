{
  "name": "phishing-url-checker",
  "version": "0.1.0",
  "description": "入力されたURLのフィッシングリスクをスコアリングするCLIツール",
  "author": "Kome",
  "license": "MIT",
  "main": "dist/index.js",
  "bin": {
    "phishing-url-checker": "dist/index.js"
  },
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:extension": "tsc -p extension/tsconfig.json && node extension/build.mjs",
    "dev:extension": "node extension/build.mjs --watch",
    "serve:test-page": "node extension/serve.mjs",
    "generate:icons": "node extension/generate-icons.mjs",
    "package:extension": "npm run build:extension && node extension/package.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "archiver": "^7.0.1",
    "esbuild": "^0.23.1",
    "pngjs": "^7.0.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
